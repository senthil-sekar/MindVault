# MindVault Backend configuration
# Copy to backend/.env and adjust as needed. Every value below is optional —
# the defaults shown are what app/config.py uses when the variable is unset.
# Variable names must match the field names in app/config.py (case-insensitive).

# ── Qdrant (local, via docker-compose) ────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=mindvault

# ── Qdrant Cloud (optional; overrides host/port when set) ─────────
# QDRANT_URL=https://xxxx.cloud.qdrant.io
# QDRANT_API_KEY=

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── Embeddings (local sentence-transformers, no API key) ──────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── LLM (local Ollama, no API key) ────────────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# ── Retrieval ─────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MIN_SCORE=0.1
